{
  "id": "rb-starter-login-check-ios",
  "name": "Login check (iPhone)",
  "description": "Opens TikTok on an iPhone, goes to the profile and checks the handle is on screen, with a picture of it either way. Schedule it daily: it is how a logged-out phone announces itself.",
  "platform": "ios",
  "appId": "com.zhiliaoapp.musically",
  "createdFor": {
    "udid": "starter-template-iphone8",
    "screen": {
      "width": 375,
      "height": 667,
      "scale": 2
    }
  },
  "template": "login-check-ios",
  "steps": [
    {
      "type": "launchApp",
      "appId": "com.zhiliaoapp.musically"
    },
    {
      "type": "wait",
      "ms": 7000
    },
    {
      "type": "tap",
      "target": {
        "text": "Profile",
        "fraction": {
          "x": 0.90133,
          "y": 0.98351
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true
    },
    {
      "type": "waitForText",
      "text": "Edit profile",
      "timeoutMs": 25000,
      "seen": [
        "Edit profile",
        "Following",
        "Followers",
        "Likes",
        "Posts",
        "Videos",
        "Liked"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "assert",
      "text": "{{handle}}",
      "expect": "present",
      "guess": true
    },
    {
      "type": "screenshot",
      "label": "profile"
    },
    {
      "type": "tap",
      "target": {
        "text": "Home",
        "fraction": {
          "x": 0.10133,
          "y": 0.97901
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 1500
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "lastValues": {
    "handle": "@your.handle"
  }
}
