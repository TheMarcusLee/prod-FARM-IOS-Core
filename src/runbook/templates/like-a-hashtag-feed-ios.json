{
  "id": "rb-starter-like-a-hashtag-feed-ios",
  "name": "Like a hashtag feed (iPhone)",
  "description": "Searches a hashtag on an iPhone, opens its top video, and taps the heart as many times as you ask for, leaving a human gap between each, then comes back to the feed.",
  "platform": "ios",
  "appId": "com.zhiliaoapp.musically",
  "createdFor": {
    "udid": "starter-template-iphone8",
    "screen": {
      "width": 375,
      "height": 667,
      "scale": 2
    }
  },
  "template": "like-a-hashtag-feed-ios",
  "steps": [
    {
      "type": "launchApp",
      "appId": "com.zhiliaoapp.musically"
    },
    {
      "type": "wait",
      "ms": 7000
    },
    {
      "type": "tap",
      "target": {
        "text": "Search",
        "fraction": {
          "x": 0.92,
          "y": 0.06747
        }
      },
      "seen": [
        "For You",
        "Following",
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Search"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "type",
      "text": "{{hashtag}}"
    },
    {
      "type": "key",
      "key": "enter"
    },
    {
      "type": "waitForText",
      "text": "Hashtags",
      "timeoutMs": 25000,
      "seen": [
        "Top",
        "Users",
        "Videos",
        "Sounds",
        "LIVE",
        "Hashtags"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.25,
          "y": 0.28
        }
      },
      "seen": [
        "Top",
        "Users",
        "Videos",
        "Sounds",
        "LIVE",
        "Hashtags"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 4000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.92,
          "y": 0.46927
        }
      },
      "seen": [
        "Like",
        "Liked",
        "Add to Favorites",
        "Favorites",
        "Share",
        "Comment",
        "Follow"
      ],
      "guess": true,
      "optional": true,
      "repeat": "{{likes}}",
      "repeatDelayMs": 5000
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "swipe",
      "from": {
        "x": 0.01333,
        "y": 0.5
      },
      "to": {
        "x": 0.6,
        "y": 0.5
      },
      "durationMs": 350
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "tap",
      "target": {
        "text": "Home",
        "fraction": {
          "x": 0.10133,
          "y": 0.97901
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 1500
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "lastValues": {
    "hashtag": "#homegym",
    "likes": "3"
  }
}
