{
  "id": "rb-starter-threads-photo-post",
  "name": "Threads photo post",
  "description": "Posts the newest picture in the phone gallery as a thread, with wording you fill in each run.",
  "platform": "android",
  "appId": "com.instagram.barcelona",
  "createdFor": {
    "udid": "starter-template",
    "screen": {
      "width": 1080,
      "height": 2400,
      "scale": 1
    }
  },
  "template": "threads-photo-post",
  "steps": [
    {
      "type": "launchApp",
      "appId": "com.instagram.barcelona"
    },
    {
      "type": "wait",
      "ms": 6000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.5,
          "y": 0.62
        },
        "text": "Not now"
      },
      "seen": [
        "Not now",
        "Allow",
        "Continue",
        "Skip"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.7,
          "y": 0.965
        },
        "id": "compose_tab",
        "text": "Create"
      },
      "seen": [
        "For you",
        "Following",
        "Home",
        "Search",
        "Activity",
        "Profile",
        "Create",
        "Compose"
      ],
      "guess": true
    },
    {
      "type": "waitForText",
      "text": "Post",
      "timeoutMs": 30000,
      "seen": [
        "What's new?",
        "Start a thread",
        "Post",
        "New thread",
        "Cancel",
        "Add to thread"
      ],
      "guess": true
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.5,
          "y": 0.2
        },
        "id": "text_post_composer_edit_text",
        "text": "What's new?"
      },
      "seen": [
        "What's new?",
        "Start a thread",
        "Post",
        "New thread",
        "Cancel",
        "Add to thread"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "type",
      "text": "{{text}}"
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.11,
          "y": 0.45
        },
        "id": "composer_attach_media",
        "text": "Add photos"
      },
      "seen": [
        "What's new?",
        "Start a thread",
        "Post",
        "New thread",
        "Cancel",
        "Add to thread",
        "Add photos",
        "Attach media"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.5,
          "y": 0.62
        },
        "text": "Allow"
      },
      "seen": [
        "Allow",
        "Allow all",
        "Select photos",
        "Not now"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.17,
          "y": 0.3
        }
      },
      "seen": [
        "Recents",
        "All photos",
        "Camera roll",
        "Add",
        "Done",
        "Next",
        "Gallery"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.86,
          "y": 0.94
        },
        "id": "gallery_done_button",
        "text": "Add"
      },
      "seen": [
        "Recents",
        "All photos",
        "Camera roll",
        "Add",
        "Done",
        "Next",
        "Gallery"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.86,
          "y": 0.94
        },
        "id": "share_button",
        "text": "Post"
      },
      "seen": [
        "What's new?",
        "Start a thread",
        "Post",
        "New thread",
        "Cancel",
        "Add to thread"
      ],
      "guess": true
    },
    {
      "type": "waitForText",
      "text": "Posted",
      "timeoutMs": 180000,
      "seen": [
        "Posted",
        "Your thread was posted",
        "Posting"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 5000
    },
    {
      "type": "key",
      "key": "home"
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
