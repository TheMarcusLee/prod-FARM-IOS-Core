        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.49333,
          "y": 0.23688
        }
      },
      "seen": [
        "Switch account",
        "Add account",
        "Manage accounts",
        "Log out"
      ],
      "guess": true
