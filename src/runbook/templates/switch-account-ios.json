    {
      "type": "wait",
      "ms": 8000
    },
    {
      "type": "tap",
      "target": {
        "text": "Profile",
        "fraction": {
          "x": 0.90133,
          "y": 0.98351
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "screenshot",
      "label": "after-the-switch"
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
