{
  "id": "rb-starter-follow-back-sweep-ios",
  "name": "Follow-back sweep (iPhone)",
  "description": "Opens the inbox on an iPhone and taps Follow on the newest rows, up to the number you ask for.",
  "platform": "ios",
  "appId": "com.zhiliaoapp.musically",
  "createdFor": {
    "udid": "starter-template-iphone8",
    "screen": {
      "width": 375,
      "height": 667,
      "scale": 2
    }
  },
  "template": "follow-back-sweep-ios",
  "steps": [
    {
      "type": "launchApp",
      "appId": "com.zhiliaoapp.musically"
    },
    {
      "type": "wait",
      "ms": 7000
    },
    {
      "type": "tap",
      "target": {
        "text": "Inbox",
        "fraction": {
          "x": 0.69867,
          "y": 0.98201
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true
    },
    {
      "type": "waitForText",
      "text": "followed you",
      "timeoutMs": 25000,
      "seen": [
        "All activity",
        "Followers",
        "Likes",
        "Comments",
        "Mentions and tags",
        "followed you",
        "Follow back"
      ],
      "guess": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "tap",
      "target": {
        "text": "Follow",
        "fraction": {
          "x": 0.88,
          "y": 0.22
        }
      },
      "seen": [
        "All activity",
        "Followers",
        "Likes",
        "Comments",
        "Mentions and tags",
        "followed you",
        "Follow back"
      ],
      "guess": true,
      "optional": true,
      "repeat": "{{follows}}",
      "repeatDelayMs": 3500
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "tap",
      "target": {
        "text": "Home",
        "fraction": {
          "x": 0.10133,
          "y": 0.97901
        }
      },
      "seen": [
        "Home",
        "Friends",
        "Inbox",
        "Profile",
        "Create",
        "Add"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 1500
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "lastValues": {
    "follows": "5"
  }
}
