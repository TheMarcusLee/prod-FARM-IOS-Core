{
  "id": "rb-starter-threads-warm-up-ios",
  "name": "Threads warm-up (iPhone)",
  "description": "Opens Threads, lands on the feed, and scrolls it as many times as you ask for, then goes Home.",
  "platform": "ios",
  "appId": "com.burbn.barcelona",
  "createdFor": {
    "udid": "starter-template-iphone8",
    "screen": {
      "width": 375,
      "height": 667,
      "scale": 2
    }
  },
  "template": "threads-warm-up-ios",
  "steps": [
    {
      "type": "launchApp",
      "appId": "com.burbn.barcelona"
    },
    {
      "type": "wait",
      "ms": 6000
    },
    {
      "type": "tap",
      "target": {
        "fraction": {
          "x": 0.101,
          "y": 0.979
        },
        "text": "Home"
      },
      "seen": [
        "For you",
        "Following",
        "Home",
        "Search",
        "Activity",
        "Profile"
      ],
      "guess": true,
      "optional": true
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "swipe",
      "from": {
        "x": 0.5,
        "y": 0.82
      },
      "to": {
        "x": 0.5,
        "y": 0.24
      },
      "durationMs": 420,
      "repeat": "{{scrolls}}",
      "repeatDelayMs": 5200
    },
    {
      "type": "assert",
      "text": "For you",
      "expect": "present",
      "optional": true,
      "guess": true
    },
    {
      "type": "key",
      "key": "home"
    }
  ],
  "version": 1,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "lastValues": {
    "scrolls": "12"
  }
}
