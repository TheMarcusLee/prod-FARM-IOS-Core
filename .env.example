# Phone Farm configuration.
#
# Copy to `.env`. Every process loads it with `--env-file-if-exists=.env`; the
# device-facing ones (`web`, `worker`, `wda:service`, `wda:prepare`, `mcp`) also
# load `.env.devices` if it exists. Nothing here is required to start on
# loopback with an empty fleet — the defaults shown are the code's own.
#
# The desktop app (`npm run desktop:dev`) does NOT read this file. It builds the
# child environment from `~/Library/Application Support/Phone Farm/settings.json`
# instead — see docs/desktop.md.


# ── Web server ────────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Origins allowed to make cross-origin writes (the CSRF allow-list). With both
# unset, only same-host requests may write. A `Bearer` token always passes.
# PUBLIC_ORIGIN=https://farm-mac.tailnet-1234.ts.net
# PHONE_FARM_TRUSTED_ORIGINS=
# Link target for the dashboard footer. Default https://agniverse.co
# PHONE_FARM_BRAND_URL=
# JSON file whose contents `GET /health` echoes as `release`. Default RELEASED
# PHONE_FARM_RELEASE_FILE=RELEASED


# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phone_farm:CHANGE_ME@127.0.0.1:5432/phone_farm
# pg Pool `max`. Default 10.
# DATABASE_POOL_SIZE=10
# Read by docker-compose.yml only, for the bundled Postgres container.
POSTGRES_DB=phone_farm
POSTGRES_USER=phone_farm
POSTGRES_PASSWORD=CHANGE_ME


# ── Authentication ────────────────────────────────────────────────────────────
# Required before WEB_HOST is moved off loopback; startup fails otherwise.
# `local` is the built-in password + API-token provider — see docs/auth.md.
# PHONE_FARM_AUTH_PLUGIN=local
# Password hash, session key and API-token digests.
# Default: `.auth.json` beside DEVICES_CONFIG_PATH.
# AUTH_STATE_PATH=
# Cookie session lifetime in hours. Default 12.
# AUTH_SESSION_HOURS=12
# Failed logins allowed per window, and the window. Defaults 5 and 15.
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_MINUTES=15
# Non-interactive password for `npm run auth:set-password`. Prefer the prompt.
# PHONE_FARM_PASSWORD=


# ── Rate limits (all /api/* requests, keyed on the API token) ─────────────────
# `off` disables them entirely. See docs/mobile-api.md.
# RATE_LIMITS=
# POST /api/devices/:udid/remote/action — per second, per device+token. Default 10.
# RATE_LIMIT_ACTION=10
# GET  /api/devices/:udid/remote/screenshot — per second, per device+token. Default 5.
# RATE_LIMIT_SCREENSHOT=5
# Other reads, per minute per token. Default 300.
# RATE_LIMIT_READ=300
# Other writes, per minute per token. Default 60.
# RATE_LIMIT_WRITE=60


# ── Plugins ───────────────────────────────────────────────────────────────────
# Comma-separated ESM packages. Empty is a valid fleet-only installation; the
# built-in TikTok and runbook plugins load regardless.
PHONE_FARM_PLUGINS=


# ── Devices ───────────────────────────────────────────────────────────────────
DEVICES_CONFIG_PATH=devices.json
# Device unlock passcodes live in devices.json ("passcode" per entry), which is
# git-ignored and written 0600 — not in this file.
# `off` skips `adb devices -l` discovery entirely, for an iOS-only host.
ANDROID_DISCOVERY=on
# Only read by the desktop app, to find `adb` when it is not on PATH.
# ANDROID_HOME=
# ANDROID_SDK_ROOT=


# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_DATA_DIR=.scheduler-data
# Grace period after a scheduled time before an execution is abandoned. Default 30.
# SCHEDULER_RUN_WINDOW_MINUTES=30
# Refuses two schedules on one device whose windows are closer than this. Default 10.
# SCHEDULER_MIN_TASK_GAP_MINUTES=10
# Executions kept by the worker's cleanup pass. Default 30.
# SCHEDULER_HISTORY_DAYS=30
# Age at which an uploaded-but-never-scheduled asset is swept. Default 24, min 1.
# SCHEDULER_ORPHAN_ASSET_HOURS=24


# ── Appium (iOS only) ─────────────────────────────────────────────────────────
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4725


# ── iOS: WebDriverAgent, Xcode and signing ────────────────────────────────────
# Host-side forwarded ports for the first device; later devices get 8101/9101, …
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100
# The ports WDA and its MJPEG server use *on the phone*. Both default to the
# host values above; there is rarely a reason to change them.
# WDA_REMOTE_PORT=8100
# MJPEG_REMOTE_PORT=9100
# Unix socket the wda-service supervisor listens on. Default .wda/wda-service.sock
# WDA_SERVICE_SOCKET=.wda/wda-service.sock
# Required for WDA build/signing on a physical device.
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID=Apple Development
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
# IPHONEOS_DEPLOYMENT_TARGET for the WebDriverAgent build. Default 16.7.
IOS_PLATFORM_VERSION=16.7
# Xcode toolchain. Default /Applications/Xcode_26.2.app/Contents/Developer
# XCODE_DEVELOPER_DIR=
# The appium-xcuitest-driver checkout whose WebDriverAgent is patched and built.
# Default: the copy under .appium2 installed by `npm run appium:install-driver`.
# XCUITEST_DRIVER_PATH=
# Override the WebDriverAgent Xcode project path (advanced).
# WDA_PROJECT_PATH=
# Passed to Appium as `appium:bootstrapPath` for the standalone TikTok scripts.
# WDA_BOOTSTRAP_PATH=
# `true` lets Xcode add unknown UDIDs to the provisioning profile during a build.
# ALLOW_PROVISIONING_DEVICE_REGISTRATION=false
# `true` streams the raw xcodebuild log from Appium.
# SHOW_XCODE_LOG=false
#
# Optional. `wda:prepare` targets the sole registered (devices.json) or connected
# device, or takes `--udid <udid>` / `--all`. Set this only to pin one device for
# the standalone scripts. `xcrun xctrace list devices` lists UDIDs.
# IOS_UDID=
# Deprecated passcode fallback for the standalone scripts. Prefer devices.json.
# IOS_PASSCODE=
# IOS_PASSCODE_<UDID>=
# Talk to an already-running WebDriverAgent / MJPEG server instead of one this
# repo supervises. Defaults http://127.0.0.1:8100 and http://127.0.0.1:9100.
# WDA_URL=
# MJPEG_URL=


# ── TikTok plugin ─────────────────────────────────────────────────────────────
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
# The Android package name. Default com.zhiliaoapp.musically
# TIKTOK_PACKAGE=com.zhiliaoapp.musically
# Handle to switch to before a routine runs, e.g. @farm.one. Normally set
# per-execution by the plugin, not here.
# TIKTOK_SWITCH_ACCOUNT=
# Doomscroll defaults for a hand-run script; the plugin sets these per execution.
# DOOMSCROLL_PERSONALITY=casual          # skimmer | casual | engaged
# DOOMSCROLL_DURATION_MINUTES=5          # 1–180
# DOOMSCROLL_LIKE_ENABLED=true
# DOOMSCROLL_SAVE_ENABLED=true


# ── Content library and drip queue — see docs/content-queue.md ────────────────
# Defaults to $SCHEDULER_DATA_DIR/content; keep it under the data directory.
# CONTENT_DIR=
DRIP_PLANNER_INTERVAL_MINUTES=60
# Concurrent FFmpeg jobs during ingest.
CONTENT_CONCURRENCY=2
# ffmpeg/ffprobe are taken from PATH, then from the bundled static builds.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional; without it POST /api/content/ingest-url answers 501.
# YT_DLP_PATH=


# ── Alerts — see docs/fleet-and-alerts.md ─────────────────────────────────────
# Any channel left unset is simply not used.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_SLACK_WEBHOOK_URL=
# NOTIFY_DISCORD_WEBHOOK_URL=
# NOTIFY_NTFY_URL=https://ntfy.sh/replace-with-an-unguessable-topic
# NOTIFY_NTFY_TOKEN=
# info | warning | error. Default warning.
# NOTIFY_MIN_SEVERITY=warning
# Comma-separated event kinds. When set it replaces the severity floor entirely.
# NOTIFY_KINDS=
# Daily digest slot. Defaults 08:00 and UTC.
# DIGEST_LOCAL_TIME=08:00
# DIGEST_TIMEZONE=UTC
# Used to build deep links inside alerts and push notifications.
# PUBLIC_BASE_URL=https://farm-mac.tailnet-1234.ts.net


# ── Push relay (`npm run push:relay`) — see docs/push-relay.md ────────────────
# FARM_BASE_URL=http://127.0.0.1:3000
# Bearer token from `npm run token:create -- --name push-relay`.
# FARM_API_TOKEN=
# Cursor file. Default $SCHEDULER_DATA_DIR/push-relay.json
# PUSH_RELAY_STATE_PATH=
# HH:MM-HH:MM; wraps past midnight. Inside it, only `error` is pushed.
# PUSH_QUIET_HOURS=22:00-07:00
# IANA zone the quiet window is read in. Defaults to DIGEST_TIMEZONE, else UTC.
# PUSH_TIMEZONE=
# At most one push per phone per window. Default 30000.
# PUSH_COALESCE_WINDOW_MS=30000
# How long a ticket waits before its Expo receipt is read. Default 900000.
# PUSH_RECEIPT_DELAY_MS=900000
# Only needed when the Expo project has push security enabled.
# EXPO_ACCESS_TOKEN=


# ── MCP server (`npm run mcp`, and POST /mcp) — see docs/mcp.md ───────────────
# Directories `upload_asset` may read from, comma- or colon-separated.
# Default: the content directory plus $SCHEDULER_DATA_DIR/inbox.
# MCP_UPLOAD_DIRS=


# ── Set by the farm, not by you ───────────────────────────────────────────────
# The scheduler exports these into every plugin child process; setting them here
# has no effect on a scheduled run. They are listed so a hand-run script can be
# reproduced from a failing execution's log:
#   DEVICE_UDID, DEVICE_PLATFORM (ios|android), DEVICE_DRIVER (wda|adb|a11y-bridge)
#   ANDROID_SERIAL, A11Y_BRIDGE_URL, A11Y_BRIDGE_TOKEN   (Android)
#   IOS_UDID, WDA_URL, IOS_PASSCODE                       (iOS)
